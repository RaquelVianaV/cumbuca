{
  "name": "cumbuca-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Ferramentas online para fluxo de caixa, menu semanal e precificação.",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "check": "node --check server.js && node --check public/app.js",
    "test": "node --test test/server.test.js test/layout.test.js",
    "test:visual": "playwright test",
    "verify": "npm run check && npm test && npm run test:visual",
    "deploy": "npm run verify && npx vercel --prod --yes"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0"
  }
}
